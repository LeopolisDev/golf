-- ================= SLIDER LOGIC =================
local dragging = false

local function setGravity(x)
	local percent = math.clamp(
		(x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X,
		0,
		1
	)

	local value = math.floor(percent * 200)

	fill.Size = UDim2.new(percent, 0, 1, 0)
	workspace.Gravity = value
	gravityText.Text = "Gravity: " .. value
end

slider.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		frame.Draggable = false -- prevent UI moving
		setGravity(input.Position.X)
	end
end)

slider.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
		frame.Draggable = true
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		setGravity(input.Position.X)
	end
end)

-- ================= UI UPDATE =================
local function updateUI()
	if enabled then
		label.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		label.Text = "Press F to disable"
	else
		label.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
		label.Text = "Press F to enable"
	end
end

updateUI()

-- ================= INPUT =================
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.F then
		enabled = not enabled
		updateUI()
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		guiVisible = not guiVisible
		frame.Visible = guiVisible
	end
end)

-- ================= MAIN LOOP =================
RS.Heartbeat:Connect(function()
	if not enabled then return end

	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	pcall(function()
		ReplicatedStorage.Events.AC.BallStopped:FireServer()
	end)

	VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)

	local BallsFolder = workspace:FindFirstChild("Balls")
	if not BallsFolder then return end

	local BallInstance = BallsFolder:FindFirstChild(player.Name .. "_Ball")
	if not BallInstance then return end

	local LoadedMap = workspace:FindFirstChild("LoadedMap")
	if not LoadedMap then return end

	local Map = LoadedMap:FindFirstChildOfClass("Folder")
	if not Map then return end

	local Hole = Map:FindFirstChild("Main Tiles")
	and Map["Main Tiles"]:FindFirstChild("Hole")
	and Map["Main Tiles"].Hole:FindFirstChild("Hole")

	if not Hole then return end

	pcall(function()
		if BallInstance:IsA("Model") and BallInstance.PrimaryPart then
			BallInstance:SetPrimaryPartCFrame(Hole.CFrame)
		elseif BallInstance:IsA("BasePart") then
			BallInstance.CFrame = Hole.CFrame
		end
	end)
end)

