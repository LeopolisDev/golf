-- ================= UI UPDATE =================
local function updateUI()
	if enabled then
		label.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		label.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	end
end

updateUI()

-- ================= BALL =================
local function getBall()
	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") and string.find(v.Name:lower(), "ball") then
			return v
		end
	end
end

-- ================= INPUT =================
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.F then
		enabled = not enabled
		updateUI()
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		guiVisible = not guiVisible
		gui.Enabled = guiVisible
		return
	end

	if enabled and input.UserInputType == Enum.UserInputType.MouseButton1 then
		local ball = getBall()
		if ball then
			local target = mouse.Hit.Position
			ball.Anchored = true
			ball.CFrame = CFrame.new(target)
		end
	end
end)

-- ================= DISCORD =================
button.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard("https://discord.gg/MSwe4DyuF2")
	end

	copiedLabel.Text = "Link copied!"
	task.wait(2)
	copiedLabel.Text = ""
end)
