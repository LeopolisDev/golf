local ball = nil

-- ================= SAFE BALL FINDER =================
local function findBall()
	-- quick search first
	for _, v in ipairs(workspace:GetChildren()) do
		if v:IsA("BasePart") and v.Name:lower():find("ball") then
			return v
		end
	end

	-- deeper search without freezing
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") and v.Name:lower():find("ball") then
			return v
		end

		task.wait()
	end
end

-- find ball asynchronously
task.spawn(function()
	ball = findBall()

	if ball then
		ball.Anchored = true
	end
end)

