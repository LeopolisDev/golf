-- ================= UI UPDATE =================
local function updateUI()
	if enabled then
		label.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
	else
		label.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
	end
end

updateUI()

-- ================= INPUT =================
UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	-- toggle script
	if input.KeyCode == Enum.KeyCode.F then
		enabled = not enabled
		updateUI()
		return
	end

	-- hide/show menu
	if input.KeyCode == Enum.KeyCode.RightShift then
		guiVisible = not guiVisible
		gui.Enabled = guiVisible
		return
	end

	-- move ball
	if enabled and input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not ball or not ball.Parent then
			return
		end

		ball.CFrame = CFrame.new(mouse.Hit.Position)
	end
end)

