-- ================= UPDATE UI =================
local function updateUI()
	if enabled then
		label.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
		label.Text = "Press F to disable"
	else
		label.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
		label.Text = "Press F to enable"
	end
end

updateUI()

-- ================= INPUT =================
UIS.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		enabled = not enabled
		updateUI()
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		guiVisible = not guiVisible
		frame.Visible = guiVisible
	end
end)

-- ================= MAIN LOOP =================
RS.Heartbeat:Connect(function()
	if not enabled then
		return
	end

	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	pcall(function()
		ReplicatedStorage.Events.AC.BallStopped:FireServer()
	end)

	VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)

	local LoadedMap = workspace:FindFirstChild("LoadedMap")
	if not LoadedMap then
		return
	end

	local Map = LoadedMap:FindFirstChildOfClass("Folder")
	if not Map then
		return
	end

	local MainTiles = Map:FindFirstChild("Main Tiles")
	if not MainTiles then
		return
	end

	local HoleFolder = MainTiles:FindFirstChild("Hole")
	if not HoleFolder then
		return
	end

	local Hole = HoleFolder:FindFirstChild("Hole")
	if not Hole then
		return
	end

	local BallsFolder = workspace:FindFirstChild("Balls")
	if not BallsFolder then
		return
	end

	local BallInstance = BallsFolder:FindFirstChild(player.Name .. "_Ball")
	if not BallInstance then
		return
	end

	pcall(function()
		ReplicatedStorage.Events.AC.BallStopped:FireServer()

		if BallInstance:IsA("Model") then
			if BallInstance.PrimaryPart then
				BallInstance:SetPrimaryPartCFrame(Hole.CFrame)
			else
				local pp = BallInstance:FindFirstChildWhichIsA("BasePart")
				if pp then
					BallInstance.PrimaryPart = pp
					BallInstance:SetPrimaryPartCFrame(Hole.CFrame)
				end
			end
		elseif BallInstance:IsA("BasePart") then
			BallInstance.CFrame = Hole.CFrame
		end
	end)
end)

